{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"docs": {
			"dependsOn": ["^build"],
			"outputs": ["docs/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
