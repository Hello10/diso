{
	"name": "@diso.io/bark",
	"version": "1.0.0-beta.0",
	"description": "Small, addressable structured logger — filter by name + level via one env var",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Stephen Handley",
		"email": "stephen@hello10.com",
		"url": "https://hello10.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Hello10/diso.git",
		"directory": "packages/bark"
	},
	"keywords": [
		"logger",
		"logging",
		"structured",
		"debug",
		"bunyan",
		"diso"
	],
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build",
		"docs": "typedoc"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"typedoc": "^0.28.20"
	}
}
