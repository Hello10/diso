{
	"name": "@diso.io/groutcho-react",
	"version": "4.0.0-beta.0",
	"description": "React bindings for groutcho — hooks, provider, and Link over the core store",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Stephen Handley",
		"email": "stephen@hello10.com",
		"url": "https://hello10.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Hello10/groutcho.git",
		"directory": "packages/groutcho/react"
	},
	"keywords": [
		"router",
		"react",
		"hooks",
		"usesyncexternalstore",
		"groutcho"
	],
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@diso.io/groutcho": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18.0.0"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.1",
		"happy-dom": "^20.11.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
